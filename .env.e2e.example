# Disposable local environment for the Playwright browser tests.
# Copy to .env.e2e. These values are synthetic and must never be used in production.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/codra_e2e
REDIS_URL=redis://127.0.0.1:6379
PORT=3000

GITHUB_APP_ID=1
GITHUB_APP_SLUG=codra-e2e
GITHUB_APP_WEBHOOK_SECRET=e2e-only-not-a-secret
GITHUB_CLIENT_ID=e2e-only-client-id
GITHUB_CLIENT_SECRET=e2e-only-client-secret
AUTH_CALLBACK_URL=http://localhost:3000/auth/github/callback
APP_URL=http://localhost:3000
DASHBOARD_ALLOWED_USERS=codra-e2e
LLM_CONFIG_ENCRYPTION_KEY=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
BOT_USERNAME=codra-e2e
ENVIRONMENT=test

START_API=true
START_WORKER=false
TELEMETRY_DISABLED=true
