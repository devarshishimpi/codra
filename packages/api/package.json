{
  "name": "@codraoss/api",
  "version": "0.9.12",
  "description": "Codra's HTTP surface as a mountable Hono router, wired through ports.",
  "author": "Devarshi Shimpi",
  "license": "AGPL-3.0-only",
  "homepage": "https://codra.run",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devarshishimpi/codra.git",
    "directory": "packages/api"
  },
  "bugs": {
    "url": "https://github.com/devarshishimpi/codra/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.js"
    },
    "./platform": {
      "types": "./dist/platform/index.d.ts",
      "import": "./dist/platform/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "prepack": "node ../../scripts/swap-publish-exports.mjs promote",
    "postpack": "node ../../scripts/swap-publish-exports.mjs restore"
  },
  "dependencies": {
    "hono": "^4.12.34",
    "zod": "^4.3.6",
    "@codraoss/schema": "*",
    "@codraoss/core": "*",
    "@codraoss/db": "*",
    "@codraoss/provider-github": "*",
    "@codraoss/models": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.3",
    "tsup": "^8.0.2"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
